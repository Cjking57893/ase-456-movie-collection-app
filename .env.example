# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Firebase Web Configuration
FIREBASE_API_KEY_WEB=your_firebase_web_api_key
FIREBASE_APP_ID_WEB=your_firebase_web_app_id
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Android Configuration
FIREBASE_API_KEY_ANDROID=your_firebase_android_api_key
FIREBASE_APP_ID_ANDROID=your_firebase_android_app_id

# Firebase iOS/macOS Configuration
FIREBASE_API_KEY_IOS=your_firebase_ios_api_key
FIREBASE_APP_ID_IOS=your_firebase_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.example.movieCollectionApp

# Firebase Windows Configuration
FIREBASE_API_KEY_WINDOWS=your_firebase_windows_api_key
FIREBASE_APP_ID_WINDOWS=your_firebase_windows_app_id

# Firebase Common Configuration
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
